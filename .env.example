# Copie este archivo como .env. Todos estos valores son exclusivamente locales.
PUBLIC_BASE_URL=http://openiotdata.localhost:8080
WEB_PORT=8080
FRONTEND_PORT=3000
API_PORT=8000

POSTGRES_DB=openiotdata
POSTGRES_USER=openiotdata
POSTGRES_PASSWORD=openiotdata-local-only
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=openiotdata
MINIO_ROOT_PASSWORD=openiotdata-minio-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=openiotdata
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000,http://localhost:8080,http://openiotdata.localhost:8080

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-only
KEYCLOAK_PORT=8081
OIDC_ISSUER_URL=http://openiotdata.localhost:8080/auth/realms/openiotdata
OIDC_AUDIENCE=openiotdata-api

# Nunca active este bypass en un entorno compartido o productivo.
DEV_AUTH_BYPASS=false
TOKEN_HASH_PEPPER=openiotdata-token-pepper-local-only
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://openiotdata.localhost:8080
NEXT_PUBLIC_DEMO_MODE=false

CLAMAV_PORT=3310
CLAMAV_STREAM_MAX_LENGTH=1G
MAX_UPLOAD_BYTES=1073741824
MAX_ACCOUNT_BYTES=21474836480
MAX_BATCH_RECORDS=10000
MAX_BATCH_BYTES=10485760
CELERY_CONCURRENCY=2
LOG_LEVEL=INFO
