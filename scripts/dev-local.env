# Modo host: backend FastAPI + frontend Next.js, sin Docker ni infraestructura.
# Sólo desarrollo local. No sustituye a 'make validate-beta' ni debe usarse en
# entornos compartidos. Lo consume scripts/dev-local.sh.

# --- Backend ---
APP_ENV=development
AUTO_CREATE_DB=true
DATABASE_URL=sqlite+aiosqlite:///./data/openiotdata.db
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data
CELERY_TASK_ALWAYS_EAGER=true
CLAMAV_REQUIRED=false
DEV_AUTH_BYPASS=true
CORS_ORIGINS=http://localhost:3000
TOKEN_HASH_PEPPER=openiotdata-host-local-pepper

# --- Tuning de recursos del modo host ---
DUCKDB_MEMORY_LIMIT=128MB
DUCKDB_THREADS=1
MAX_CONCURRENT_QUERIES=1
MAX_PREVIEW_ROWS=100
MAX_QUERY_ROWS=500
MAX_INFERRED_ROWS=2000000
MAX_TABULAR_INFERENCE_BYTES=67108864

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEV_AUTH_BYPASS=true
NEXT_PUBLIC_DEV_USER=local-developer
NODE_OPTIONS=--max-old-space-size=1024
