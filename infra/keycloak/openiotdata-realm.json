{
  "realm": "openiotdata",
  "displayName": "OpenIoTData (local)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "publisher",
        "description": "Puede crear y publicar datasets propios"
      },
      {
        "name": "moderator",
        "description": "Puede revisar reportes y recursos en cuarentena"
      }
    ]
  },
  "clients": [
    {
      "clientId": "openiotdata-api",
      "name": "OpenIoTData API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "openiotdata-web",
      "name": "OpenIoTData Web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*",
        "http://openiotdata.localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8080",
        "http://openiotdata.localhost:8080"
      ],
      "protocolMappers": [
        {
          "name": "openiotdata-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "openiotdata-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo.publisher",
      "firstName": "Publicador",
      "lastName": "Demostración",
      "email": "publisher@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["publisher"],
      "credentials": [
        {
          "type": "password",
          "value": "publisher-local-only",
          "temporary": false
        }
      ]
    },
    {
      "username": "demo.moderator",
      "firstName": "Moderador",
      "lastName": "Demostración",
      "email": "moderator@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["publisher", "moderator"],
      "credentials": [
        {
          "type": "password",
          "value": "moderator-local-only",
          "temporary": false
        }
      ]
    }
  ]
}
