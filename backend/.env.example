APP_ENV=development
DATABASE_URL=postgresql+asyncpg://openiotdata:openiotdata@postgres:5432/openiotdata
AUTO_CREATE_DB=false
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=/data/openiotdata
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=openiotdata
S3_SECRET_KEY=change-me
S3_BUCKET=openiotdata
S3_REGION=us-east-1
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
CLAMAV_TIMEOUT_SECONDS=300

OIDC_ISSUER_URL=http://keycloak:8080/realms/openiotdata
OIDC_AUDIENCE=openiotdata-api
# DANGER: local development only. The application refuses this flag outside APP_ENV=development/test.
DEV_AUTH_BYPASS=false
TOKEN_HASH_PEPPER=change-this-in-every-environment

CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=1073741824
MAX_BATCH_RECORDS=10000
MAX_BATCH_BYTES=10485760
RATE_LIMIT_PER_MINUTE=120
MAX_QUERY_BODY_BYTES=65536
MAX_TABULAR_INFERENCE_BYTES=268435456
MAX_PARQUET_LOGICAL_BYTES=1073741824
DUCKDB_MEMORY_LIMIT=256MB
DUCKDB_THREADS=2
PUBLIC_QUERY_TIMEOUT_SECONDS=15
MAX_CONCURRENT_QUERIES=4
